# seko-ai local development environment. Copy to .env; see docs/configuration.md.
# Throwaway values only — real deployments supply their own configuration.

SEKO_DEBUG=true
SEKO_BASE_URL=http://localhost:8080
SEKO_SESSION_SECRET=change-me-dev-only
SEKO_DATABASE_URL=sqlite:///./seko-ai.db

SEKO_OIDC_ISSUER=https://idp.example.com
SEKO_OIDC_CLIENT_ID=seko-ai
SEKO_OIDC_CLIENT_SECRET=
SEKO_OIDC_USERS_GROUP=llm-users
SEKO_OIDC_ADMINS_GROUP=llm-admins

SEKO_LITELLM_BASE_URL=http://localhost:4000
SEKO_LITELLM_MASTER_KEY=
SEKO_LLM_PUBLIC_URL=http://localhost:4000/v1
SEKO_LLM_MODEL=your-chat-model

# Probing a gateway that isn't running just logs DOWN; disable it while developing UI.
SEKO_STATUS_SCHEDULER_ENABLED=false
